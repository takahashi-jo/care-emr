rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // 入所者とそのサブコレクション（投薬など）
    match /residents/{residentId} {
      allow read, write: if isAdmin();
      match /{sub=**} {
        allow read, write: if isAdmin();
      }
    }

    // 投薬のコレクショングループ検索（回診一覧の継続薬表示・服薬フィルタ用）。
    // collectionGroup クエリはネストした match ではなく、この再帰ワイルドカードの
    // ルールが別途必要（無いと list が拒否される）。読み取り専用で許可。
    match /{path=**}/medications/{medId} {
      allow read: if isAdmin();
    }

    // 診療録：真正性のため、物理削除禁止・作成メタデータ不変（追記型）
    match /medicalRecords/{recordId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
        && request.resource.data.get('createdBy', null) == resource.data.get('createdBy', null);
      allow delete: if false; // 物理削除禁止（論理削除のみ）

      // 訂正履歴：追記のみ・変更/削除禁止
      match /revisions/{revId} {
        allow read, create: if isAdmin();
        allow update, delete: if false;
      }
    }

    // 医薬品マスター
    match /drugMaster/{docId} {
      allow read, write: if isAdmin();
    }
  }
}
